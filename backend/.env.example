# Core
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000
DATABASE_URL=postgresql://arena:arena_dev_password@localhost:5432/arena?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Hosted Judge0 API. Use your hosted Judge0 provider endpoint and API key.
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_POLL_INTERVAL_MS=800
JUDGE0_MAX_POLLS=25
JUDGE0_LANGUAGE_ID_PYTHON=100
JUDGE0_LANGUAGE_ID_CPP=54
JUDGE0_LANGUAGE_ID_JAVA=91
JUDGE0_LANGUAGE_ID_JAVASCRIPT=93

# Optional transactional email provider integration is not enabled in v1.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=The Arena <noreply@example.com>